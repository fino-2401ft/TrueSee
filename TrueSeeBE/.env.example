# TrueSee backend configuration. Copy to `.env` and adjust. Never commit `.env`.

# Runtime environment: development | test
NODE_ENV=development
# HTTP port (1-65535). Default 3000.
PORT=3000
# Interface to bind. 0.0.0.0 lets a physical phone on the same network reach the API.
HOST=0.0.0.0
# PostgreSQL connection URL (local Compose database; must match the root .env values).
DATABASE_URL=postgresql://truesee:truesee_dev_password@localhost:5432/truesee
# How long startup keeps retrying the database before exiting (1000-120000 ms). Default 30000.
DB_CONNECT_TIMEOUT_MS=30000
# Database check budget for GET /api/v1/health (100-1900 ms). Default 1500.
HEALTH_DB_TIMEOUT_MS=1500
# Log output: pretty | json. Default pretty in development, json otherwise.
LOG_FORMAT=pretty
# Log level: fatal | error | warn | info | debug | trace. Default info.
LOG_LEVEL=info

# Optional, integration tests only: database they migrate and run against.
# Defaults to postgresql://truesee:truesee_dev_password@localhost:5432/truesee_test
# TEST_DATABASE_URL=postgresql://truesee:truesee_dev_password@localhost:5432/truesee_test
