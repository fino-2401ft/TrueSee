# TrueSee mobile app configuration. Copy to `.env` and adjust.
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone: NEVER put secrets here.

# Backend base URL: absolute http(s) URL ending in /api/v1, no trailing slash.
# Android emulator: 10.0.2.2 is the host machine.
# Physical device: use your computer's LAN IP instead, e.g. http://192.168.1.20:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
# Environment label shown on the app shell: development | test
EXPO_PUBLIC_APP_ENV=development
