{
  "name": "truesee-fe",
  "version": "0.1.0",
  "description": "TrueSee mobile app",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest"
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-dev-client": "58.0.21",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "prettier": "3.10.1",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
