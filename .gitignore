# Environment files (real values never committed; examples are tracked)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Prisma client (generated on install by `prisma generate`)
TrueSeeBE/src/generated/

# Expo / React Native (native folders are generated by prebuild)
.expo/
TrueSeeFE/android/
TrueSeeFE/ios/
*.jks
*.keystore
!debug.keystore

# Local database data (if a bind mount is ever used instead of the named volume)
docker/postgres/data/

# Logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.swp
.idea/
.vscode/
