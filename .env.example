# Local PostgreSQL started by `docker compose up -d`. Copy to `.env` to override the defaults.
# These are local-only placeholder credentials, not real secrets.

# Database superuser created on first start.
POSTGRES_USER=truesee
# Password for POSTGRES_USER (local placeholder).
POSTGRES_PASSWORD=truesee_dev_password
# Development database name (the test database `truesee_test` is created automatically).
POSTGRES_DB=truesee
# Host port mapped to PostgreSQL; change it if 5432 is already in use.
POSTGRES_PORT=5432
